# =============================================================================
# Briefly local environment template (developer-safe)
# Copy to .env or your local env file and fill values as needed.
# =============================================================================

# Core optional providers (leave blank if unused)
FINNHUB_API_KEY=
NEWSAPI_KEY=
FRED_API_KEY=
OPENAI_API_KEY=

# Required etiquette for SEC EDGAR calls (no key needed)
SEC_USER_AGENT="Briefly/0.1 your-email@example.com"

# -----------------------------------------------------------------------------
# Vertical Intelligence: source configuration (Phase 1 foundations)
# -----------------------------------------------------------------------------
# Keep shadow/off defaults unless you are explicitly validating compact shadow output.
VERTICALS_INCLUDE_IN_BRIEFING=false
VERTICALS_BRIEFING_SESSIONS='["morning"]'
VERTICALS_INTRADAY_MATERIALITY_THRESHOLD=0.75

# Geopolitics
VERTICALS_GEOPOLITICS_ENABLED=false
GDELT_ENABLED=true
GDELT_TIMEOUT_SECONDS=10
GDELT_MAX_RECORDS=50

# Healthcare
VERTICALS_HEALTHCARE_ENABLED=true
CLINICALTRIALS_ENABLED=true
OPENFDA_ENABLED=true
OPENFDA_API_KEY=
EMA_ENABLED=true
SEC_USER_AGENT="Briefly/0.1 your-email@example.com"

# AI / Tech
VERTICALS_AI_TECH_ENABLED=false
ARXIV_ENABLED=true
ARXIV_TIMEOUT_SECONDS=10
GITHUB_ENABLED=false
GITHUB_TOKEN=

# Existing optional confirmation/news sources
NEWSAPI_KEY=
FINNHUB_API_KEY=
