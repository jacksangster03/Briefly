# =============================================================================
# Briefly environment configuration
# Copy to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
# DATA PROVIDERS
# ---------------------------------------------------------------------------

# Finnhub (REQUIRED for V1 — free tier: 60 calls/min)
# Get key: https://finnhub.io/register
FINNHUB_API_KEY=

# FRED (REQUIRED for macro data — free, unlimited)
# Get key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ECB Data Portal (OPTIONAL — official, free, no key required)
ECB_BASE_URL=https://data-api.ecb.europa.eu/service

# Eurostat (OPTIONAL — official, free, no key required)
EUROSTAT_BASE_URL=https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data

# BLS (OPTIONAL — official US macro data)
# Get key / docs: https://www.bls.gov/developers/
BLS_API_KEY=
BLS_BASE_URL=https://api.bls.gov/publicAPI/v2/timeseries/data/

# BEA (OPTIONAL — official US macro data)
# Get key / docs: https://apps.bea.gov/api/signup/
BEA_API_KEY=
BEA_BASE_URL=https://apps.bea.gov/api/data

# SEC EDGAR (REQUIRED — no key needed, just a User-Agent string)
# Format: "AppName YourEmail" per SEC fair-access policy
SEC_USER_AGENT=Briefly your@email.com

# ---------------------------------------------------------------------------
# HEALTHCARE / BIOTECH INTELLIGENCE (OPTIONAL RESEARCH INPUTS)
# ---------------------------------------------------------------------------
# Note: healthcare section enable/filters live in configs/healthcare.yaml.
# These are free/public sources you can use for research workflows.
#
# 1) SEC EDGAR company filings (already covered above)
#    Link: https://www.sec.gov/edgar/searchedgar/companysearch
#
# 2) FDA openFDA API (no key required)
#    Docs: https://open.fda.gov/apis/
FDA_OPENFDA_BASE_URL=https://api.fda.gov
FDA_OPENFDA_API_KEY=
#
# 3) ClinicalTrials.gov API v2 (no key required)
#    Docs: https://clinicaltrials.gov/data-api/about-api
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
#
# 4) EMA medicines/regulatory pages (public web source, no key)
#    Portal: https://www.ema.europa.eu/en/medicines
EMA_MEDICINES_BASE_URL=https://www.ema.europa.eu/en/medicines
# Official-source ingestion toggles/budgets (optional; diagnostics-first defaults)
ENABLE_HEALTHCARE_OFFICIAL_SOURCES=false
ENABLE_HEALTHCARE_SEC_SOURCE=true
ENABLE_HEALTHCARE_OPENFDA_SOURCE=false
ENABLE_HEALTHCARE_CLINICALTRIALS_SOURCE=false
ENABLE_HEALTHCARE_EMA_SOURCE=false
HEALTHCARE_SEC_DAILY_CALL_BUDGET=100
HEALTHCARE_OPENFDA_DAILY_CALL_BUDGET=100
HEALTHCARE_CLINICALTRIALS_DAILY_CALL_BUDGET=100
HEALTHCARE_EMA_DAILY_CALL_BUDGET=50
HEALTHCARE_SOURCE_TIMEOUT_SECONDS=20

# NewsAPI (OPTIONAL — free tier: 100 req/day, headlines only)
# Get key: https://newsapi.org/register
NEWSAPI_KEY=

# Marketaux (OPTIONAL — finance-focused news feed)
# Get key: https://www.marketaux.com/
MARKETAUX_API_KEY=

# Alpha Vantage NEWS_SENTIMENT (OPTIONAL — free tier is limited/day)
# Get key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Financial Modeling Prep (OPTIONAL — supplemental finance feed)
# Get key: https://site.financialmodelingprep.com/developer
FMP_API_KEY=

# Mediastack (OPTIONAL — low-volume backup feed)
# Get key: https://mediastack.com/signup/free
MEDIASTACK_API_KEY=

# Polygon (OPTIONAL — paid, not needed for V1)
POLYGON_API_KEY=

# Alpaca (OPTIONAL — for paper trading module)
# Get keys: https://app.alpaca.markets/signup
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# X / Twitter (OPTIONAL — for social signal layer, disabled by default)
X_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# LLM PROVIDERS (OPTIONAL — for AI summarisation in Phase 3+)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# DELIVERY CHANNELS
# ---------------------------------------------------------------------------

# Telegram (REQUIRED for V1)
# 1. Message @BotFather on Telegram, create a bot, get the token
# 2. Message your bot, then GET https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (OPTIONAL backup channel)
# For Gmail, use an App Password (not your normal login password):
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/state/market_briefing.db

# ---------------------------------------------------------------------------
# GENERAL
# ---------------------------------------------------------------------------
TIMEZONE=Europe/Madrid
DRY_RUN=true
ALLOW_LIVE_TRADING=false
LOG_LEVEL=INFO
# Phase 3.5 delivery controls
ENABLE_CHARTS=true
# When true, sends a hero chart image to Telegram before morning text.
TELEGRAM_SEND_CHARTS=false
# Phase 4 LLM email render controls
# Keep this OFF until you've validated shadow-mode output.
ENABLE_LLM_EMAIL_RENDER=true
# true  = run LLM render but keep deterministic email as the sent output
# false = use LLM-rendered email as active output when validation passes
LLM_RENDER_SHADOW_MODE=true
# LLM model for email rendering (render-only layer, deterministic ranking stays upstream)
LLM_EMAIL_MODEL=gpt-4o-mini
# Optional usage-cost estimation (USD per 1M tokens). Set to 0 to disable.
# Verify current model pricing before setting these in production.
LLM_EMAIL_INPUT_COST_PER_1M_TOKENS=0.15
LLM_EMAIL_OUTPUT_COST_PER_1M_TOKENS=0.60
# OpenAI-compatible API base URL (leave default for OpenAI API).
LLM_API_BASE_URL=https://api.openai.com/v1
# API timeout (seconds) for LLM render call
LLM_EMAIL_TIMEOUT_SECONDS=25
# Guardrail cap for generated body length
LLM_EMAIL_MAX_CHARS=3200
# Guardrail: minimum source URLs required in rendered output.
LLM_EMAIL_MIN_SOURCE_URLS=2
# Channel routing: all | telegram | email
DELIVERY_CHANNEL=all
# Local web control center (Phase 4.3)
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Public base URL for links in delivered emails (optional, recommended outside local preview)
WEB_PUBLIC_BASE_URL=
# Phase 4.6 cadence / breaking controls
# Follow-up delay after initial breaking alert (minutes)
BREAKING_FOLLOWUP_DELAY_MINUTES=10
# Cooldown before same storyline can alert again
BREAKING_STORYLINE_COOLDOWN_MINUTES=45
# Hard flood cap across initial + follow-up sends
BREAKING_MAX_ALERTS_PER_HOUR=3
# Minimum absolute % move in mapped assets to confirm follow-up
BREAKING_FOLLOWUP_MIN_ASSET_MOVE_PCT=0.9

# ---------------------------------------------------------------------------
# GLOBAL NEWS EXPANSION (PHASE 4.5)
# ---------------------------------------------------------------------------
# Provider toggles
ENABLE_GDELT=false
ENABLE_ALPHA_VANTAGE_NEWS=false
ENABLE_FMP_NEWS=false
ENABLE_MEDIASTACK_NEWS=false
# Reserved for future Marketaux integration wiring.
ENABLE_MARKETAUX_NEWS=false

# Optional provider endpoints
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
FMP_BASE_URL=https://financialmodelingprep.com/stable/news/general-latest
MEDIASTACK_BASE_URL=https://api.mediastack.com/v1/news
# Reserved for future Marketaux integration wiring.
MARKETAUX_BASE_URL=https://api.marketaux.com/v1/news/all

# Daily call budgets (process-level guard)
GDELT_DAILY_CALL_BUDGET=250
ALPHA_VANTAGE_NEWS_DAILY_CALL_BUDGET=20
FMP_NEWS_DAILY_CALL_BUDGET=120
MEDIASTACK_NEWS_DAILY_CALL_BUDGET=3
# Reserved for future Marketaux integration wiring.
MARKETAUX_NEWS_DAILY_CALL_BUDGET=100

# Request shaping
GLOBAL_NEWS_MAX_RECORDS=50
ALPHA_VANTAGE_TOPICS=economy_macro,economy_monetary,energy_transportation,financial_markets
GDELT_GLOBAL_QUERY=(inflation OR sanctions OR tariffs OR oil OR shipping OR blockade OR war OR ceasefire OR central bank OR rates OR treasury OR dollar OR fx OR supply chain)
FMP_NEWS_LIMIT=50
MEDIASTACK_NEWS_LIMIT=25
# Reserved for future Marketaux integration wiring.
MARKETAUX_NEWS_LIMIT=50

# ---------------------------------------------------------------------------
# PHASE 6/7 CHART STACK CONTROLS
# ---------------------------------------------------------------------------
FEATURE_YIELD_CURVE_CARD=true
FEATURE_VIX_RISK_CARD=true
FEATURE_GEO_CONFIRMATION_LADDER=true
FEATURE_REGIONAL_DIVERGENCE_SCORE=true
FEATURE_OIL_TRANSMISSION_CARD=true
FEATURE_DYNAMIC_CHART_STACK=true
# desk (3-5 charts) | full (6-9 charts)
# Also configurable per profile via delivery.email_density_mode
FEATURE_EMAIL_DENSITY_MODE=true

# ---------------------------------------------------------------------------
# NEWS CLASSIFIER / ML SHADOW MODES (OPTIONAL)
# ---------------------------------------------------------------------------
ENABLE_LLM_NEWS_CLASSIFIER=false
LLM_NEWS_CLASSIFIER_SHADOW_MODE=true
LLM_NEWS_CLASSIFIER_MODEL=gpt-4o-mini
LLM_NEWS_CLASSIFIER_MAX_ITEMS_PER_RUN=8
LLM_NEWS_CLASSIFIER_MONTHLY_BUDGET_USD=0.0

ENABLE_ML_NEWS_CLASSIFIER=false
ML_NEWS_CLASSIFIER_SHADOW_MODE=true
ML_NEWS_CLASSIFIER_MODEL_PATH=
ML_NEWS_CLASSIFIER_MAX_ITEMS=100
ML_NEWS_CLASSIFIER_MIN_SCORE=0.70
ML_NEWS_CLASSIFIER_TIMEOUT_SECONDS=2.0
ML_NEWS_CLASSIFIER_USE_IN_LIVE=false

# -----------------------------------------------------------------------------
# Vertical Intelligence: source configuration (Phase 1 foundations)
# -----------------------------------------------------------------------------
# Canonical local setup:
#   cp .env.example .env
#   # then fill real values in .env only (never commit .env).
# Keep shadow/off defaults unless you are explicitly validating compact shadow output.
VERTICALS_INCLUDE_IN_BRIEFING=false
VERTICALS_BRIEFING_SESSIONS='["morning"]'
VERTICALS_INTRADAY_MATERIALITY_THRESHOLD=0.75

# Geopolitics vertical
# GDELT: free/no key, used for geopolitics headline/event signals.
VERTICALS_GEOPOLITICS_ENABLED=false
GDELT_ENABLED=true
GDELT_TIMEOUT_SECONDS=10
GDELT_MAX_RECORDS=50

# Healthcare vertical
# Keep current behaviour in profile prefs; this env section is a safe setup guide.
VERTICALS_HEALTHCARE_ENABLED=true
# ClinicalTrials.gov: free/no key, official clinical studies API.
CLINICALTRIALS_ENABLED=true
# openFDA: free key optional/recommended for better reliability/rate limits.
OPENFDA_ENABLED=true
OPENFDA_API_KEY=
EMA_ENABLED=true
# SEC EDGAR: no API key, but requires responsible SEC_USER_AGENT etiquette.
SEC_USER_AGENT="Briefly/0.1 your-email@example.com"

# AI / Tech vertical
# arXiv: free/no key, research trend context only.
VERTICALS_AI_TECH_ENABLED=false
ARXIV_ENABLED=true
ARXIV_TIMEOUT_SECONDS=10
# GitHub: token optional; useful for stronger rate limits/private contexts.
GITHUB_ENABLED=false
GITHUB_TOKEN=

# Existing optional confirmation/news sources
# NewsAPI/Finnhub: existing optional confirmation/news providers.
NEWSAPI_KEY=
FINNHUB_API_KEY=
# Hugging Face: planned/disabled in Phase 1; no key required here yet.
